# Copia este archivo como ".env" y completa tus claves. NUNCA subas el .env a GitHub.

# Proveedor a usar: "anthropic", "openai" o "gemini" (bonus)
LLM_PROVIDER=anthropic

# Claves de API (completa al menos la del proveedor elegido)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Gratis en https://aistudio.google.com/apikey (no pide tarjeta)
GOOGLE_API_KEY=

# Opcionales (si los omitis se usan estos valores por defecto)
# LLM_MODEL=claude-haiku-4-5      # ej. gpt-4o-mini (OpenAI) / gemini-flash-latest (Gemini)
# LLM_TEMPERATURE=0.7             # OpenAI: 0-2 | Anthropic: 0-1
# LLM_MAX_TOKENS=1024
# LLM_TIMEOUT_S=30
# LLM_MAX_RETRIES=2
